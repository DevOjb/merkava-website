# Backend developer template only.
# This static frontend does not load this file. Configure these values in the
# chosen backend host's environment/secret manager after the stack is selected.

APP_ENV=development
APP_URL=
FRONTEND_ORIGIN=
API_BASE_URL=

# Database connection (names are generic; adapt to the chosen database/driver)
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Authentication/session configuration — generate strong random values securely
SESSION_SECRET=
TOKEN_SIGNING_KEY=

# Payment provider credentials — server-side only; never expose in frontend code
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email/SMS provider — optional, selected by backend developer
MAIL_PROVIDER=
MAIL_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
